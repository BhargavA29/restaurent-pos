# Copy to .env.local (dev) and .env.prod (prod migrations only).
# Dev and prod are two separate Neon databases.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Long random string, e.g. `openssl rand -base64 32`. Use a different one in prod.
SESSION_SECRET=
